{
  "manifest_version": 3,
  "name": "Medical FactGuard AI",
  "version": "1.0.0",
  "description": "Analyze medical claims and discover scientific evidence across websites.",

  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Open Medical FactGuard AI"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  }
}